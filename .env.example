# Local development. Copy to .env and adjust; never commit real values.
GUM_CONFIG=config/default.toml
DATABASE_URL=postgres://gum:gum@127.0.0.1:54329/gum
RUST_LOG=info,gum_engine=debug
# GUM_LOG_FORMAT=pretty      # human-readable logs instead of JSON

